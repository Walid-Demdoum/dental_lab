<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="web.Many2ManyBinaryField.attachment_preview" t-inherit-mode="extension">
        <xpath expr="//div[@name='attachment']/div[hasclass('o_attachment_wrap')]" position="inside">
            <button t-if="this.isViewable3D and this.isViewable3D(file)"
                    type="button"
                    class="o_attachment_3d btn btn-primary"
                    t-att-title="'View ' + file.name + ' in 3D'"
                    t-on-click.stop="() => this.open3D(file)">
                3D
            </button>
        </xpath>
    </t>

    <!-- Popup dialog hosting the viewer -->
    <t t-name="dental_lab.Viewer3DDialog">
        <Dialog size="'xl'" title="props.title" footer="false" withBodyPadding="false">
            <iframe t-att-src="props.url" class="o_dl_viewer_frame" title="3D viewer"/>
        </Dialog>
    </t>

</templates>