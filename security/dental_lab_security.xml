<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_dental_lab" model="ir.module.category">
        <field name="name">Dental Lab</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_dental_lab_technician" model="res.groups">
        <field name="name">Technician / Prosthesist</field>
        <field name="category_id" ref="module_category_dental_lab"/>
    </record>

    <record id="group_dental_lab_manager" model="res.groups">
        <field name="name">Lab Manager</field>
        <field name="category_id" ref="module_category_dental_lab"/>
        <field name="implied_ids" eval="[(4, ref('group_dental_lab_technician'))]"/>
    </record>

    <!-- Portal dentist: sees/creates only their own orders, never deletes -->
    <record id="dental_lab_order_portal_rule" model="ir.rule">
        <field name="name">Dental Lab Order: Portal Dentist - Own Orders Only</field>
        <field name="model_id" ref="model_dental_lab_order"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">0</field>
    </record>

    <!-- Technician: only orders assigned to them -->
    <record id="dental_lab_order_technician_rule" model="ir.rule">
        <field name="name">Dental Lab Order: Technician - Assigned Orders Only</field>
        <field name="model_id" ref="model_dental_lab_order"/>
        <field name="domain_force">[('technician_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_dental_lab_technician'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">1</field>
    </record>

    <!-- Lab Manager: full visibility on all orders -->
    <record id="dental_lab_order_manager_rule" model="ir.rule">
        <field name="name">Dental Lab Order: Manager - All Orders</field>
        <field name="model_id" ref="model_dental_lab_order"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_dental_lab_manager'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">1</field>
    </record>

    <!-- Portal dentist: only lines belonging to their own orders -->
    <record id="dental_lab_order_line_portal_rule" model="ir.rule">
        <field name="name">Dental Lab Order Line: Portal Dentist - Own Order Lines Only</field>
        <field name="model_id" ref="model_dental_order_line"/>
        <field name="domain_force">[('work_order_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">0</field>
    </record>

    <!-- Technician/Manager: full visibility on all lines -->
    <record id="dental_lab_order_line_technician_rule" model="ir.rule">
        <field name="name">Dental Lab Order Line: Technician/Manager - All Lines</field>
        <field name="model_id" ref="model_dental_order_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_dental_lab_technician'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">1</field>
    </record>


    <!-- Portal dentist: read-only PMMA lines of their own orders, once work has started -->
    <record id="pmma_line_portal_rule" model="ir.rule">
        <field name="name">PMMA Line: Portal Dentist - Own Orders, Read Only</field>
        <field name="model_id" ref="model_pmma_line"/>
        <field name="domain_force">[('work_order_id.partner_id', '=', user.partner_id.id), ('work_order_id.state', 'in', ['in_progress', 'done', 'cancel'])]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

</odoo>