<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_lab_order_list" model="ir.ui.view">
        <field name="name">dental.lab.order.list</field>
        <field name="model">dental.lab.order</field>
        <field name="arch" type="xml">
            <list string="Dental Work Orders"
                  decoration-success="state == 'done'"
                  decoration-info="state == 'in_progress'"
                  decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="patient_name"/>
                <field name="work_type"/>
                <field name="date_order"/>
                <field name="date_due"/>
                <field name="technician_id"/>
                <field name="priority" widget="priority" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state == 'in_progress'"
                       decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="view_dental_lab_order_form" model="ir.ui.view">
        <field name="name">dental.lab.order.form</field>
        <field name="model">dental.lab.order</field>
        <field name="arch" type="xml">
            <form string="Dental Work Order">
                <header>
                    <button name="action_start" type="object" string="Start"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_done" type="object" string="Mark as Done"
                            class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('done', 'cancel')"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to New"
                            invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="patient_name"/>
                            <field name="tooth_numbers"/>
                            <field name="work_type"/>
                        </group>
                        <group>
                            <field name="date_order"/>
                            <field name="date_due"/>
                            <field name="priority" widget="priority"/>
                            <field name="technician_id"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="shade"/>
                            <field name="material"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Special instructions from the dentist..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dental_lab_order_kanban" model="ir.ui.view">
        <field name="name">dental.lab.order.kanban</field>
        <field name="model">dental.lab.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="state"/>
                <field name="priority"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="d-flex justify-content-between">
                                <strong><field name="name"/></strong>
                                <field name="priority" widget="priority"/>
                            </div>
                            <div><field name="patient_name"/></div>
                            <div class="text-muted"><field name="work_type"/></div>
                            <div class="d-flex justify-content-between mt-2">
                                <field name="technician_id" widget="many2one_avatar_user"/>
                                <field name="date_due"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_dental_lab_order_search" model="ir.ui.view">
        <field name="name">dental.lab.order.search</field>
        <field name="model">dental.lab.order</field>
        <field name="arch" type="xml">
            <search string="Search Dental Work Orders">
                <field name="name"/>
                <field name="patient_name"/>
                <field name="partner_id" string="Dentist"/>
                <field name="technician_id"/>
                <filter name="filter_draft" string="New" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="filter_done" string="Done" domain="[('state', '=', 'done')]"/>
                <filter name="filter_urgent" string="Urgent" domain="[('priority', '=', '1')]"/>
                <separator/>
                <filter name="filter_my_orders" string="My Orders" domain="[('technician_id', '=', uid)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_by_technician" string="Technician" context="{'group_by': 'technician_id'}"/>
                    <filter name="group_by_dentist" string="Dentist" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_by_work_type" string="Work Type" context="{'group_by': 'work_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dental_lab_order" model="ir.actions.act_window">
        <field name="name">Work Orders</field>
        <field name="res_model">dental.lab.order</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_dental_lab_order_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No work orders yet</p>
            <p>Work orders submitted by dentists will appear here.</p>
        </field>
    </record>
</odoo>