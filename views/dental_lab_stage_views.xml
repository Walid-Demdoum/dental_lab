<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_lab_stage_list" model="ir.ui.view">
        <field name="name">dental.lab.order.stage.list</field>
        <field name="model">dental.lab.order.stage</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_dental_lab_stage" model="ir.actions.act_window">
        <field name="name">Work Order Steps</field>
        <field name="res_model">dental.lab.order.stage</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define the steps of your production workflow</p>
        </field>
    </record>
</odoo>