<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Portal access menu -->
    <template id="portal_my_home_dental_order" name="Show Dental Orders on Home" customize_show="True" inherit_id="portal.portal_my_home" priority="50">
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/dental_lab/static/src/img/tooth.svg'"/>
                <t t-set="title">My work orders</t>
                <t t-set="url" t-value="'/my/dental-orders'"/>
                <t t-set="text">Create or track your work orders here</t>
                <t t-set="placeholder_count" t-value="'dental_order_count'"/>
            </t>
        </div>
        
    </template>

    <!-- Order lines -->
    <!-- dental_lab/views/portal_templates.xml -->
    <template id="portal_dental_order_lines" name="Dental Work Order Lines">
        <style>
            .dental-tooth { min-width: 34px; }
            .dental-midline { width: 1px; align-self: stretch; background-color: #adb5bd; margin: 0 4px; }
            #dental-odontogram-chart { overflow-x: auto; }
            .dental-tooth { min-width: 34px; }
            .dental-midline { width: 1px; align-self: stretch; background-color: #adb5bd; margin: 0 4px; }
            #dental-odontogram-chart { overflow-x: auto; text-align: center; }
            .dental-odontogram-svg { display: block; margin: 0 auto; max-width: 100%; height: auto; }
            .dental-tooth { cursor: pointer; }
            .dental-tooth .dental-tooth-shape rect,
            .dental-tooth .dental-tooth-shape polygon {
                fill: #e9ecef;
                stroke: #6c757d;
                stroke-width: 1.5;
                transition: fill 0.15s ease, stroke 0.15s ease;
            }
            .dental-tooth:hover .dental-tooth-shape rect,
            .dental-tooth:hover .dental-tooth-shape polygon {
                stroke: #0d6efd;
            }
            .dental-tooth.active .dental-tooth-shape rect,
            .dental-tooth.active .dental-tooth-shape polygon {
                fill: #0d6efd;
                stroke: #0a58ca;
            }
            .dental-tooth-label {
                font-size: 11px;
                fill: #495057;
                pointer-events: none;
                user-select: none;
            }
            .dental-tooth.active .dental-tooth-label {
                fill: #0d6efd;
                font-weight: 600;
            }
            .dental-midline-guide {
                stroke: #ced4da;
                stroke-dasharray: 4 3;
                stroke-width: 1;
            }
        </style>
        <div class="col-12">
            <label class="form-label fw-bold">Work Details</label>
            <div id="dental-lines-container">
                <t t-if="order">
                    <t t-foreach="order.work_order_line_ids" t-as="line" t-key="line.id">
                        <div class="row g-2 align-items-end dental-line-row border rounded p-2 mb-2">
                            <input type="hidden" t-attf-name="lines-#{line_index}-line_id" t-att-value="line.id"/>
                            <div class="col-md-2">
                                <label class="form-label">Teeth</label>
                                <input type="text" class="form-control dental-teeth-input" readonly="readonly"
                                    required="required" placeholder="Select..."
                                    t-attf-name="lines-#{line_index}-teeth" t-att-value="line.teeth"/>
                                <button type="button" class="btn btn-outline-secondary btn-sm w-100 mt-1 dental-select-teeth">Select</button>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Work Type</label>
                                <select class="form-select" required="required" t-attf-name="lines-#{line_index}-work_type">
                                    <option value="">-- Select --</option>
                                    <option value="zircon" t-att-selected="'selected' if line.work_type == 'zircon' else None">Zircon</option>
                                    <option value="ccm" t-att-selected="'selected' if line.work_type == 'ccm' else None">CCM</option>
                                    <option value="ceramic_metal" t-att-selected="'selected' if line.work_type == 'ceramic_metal' else None">Metal-Ceramic</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Description</label>
                                <input type="text" class="form-control" t-attf-name="lines-#{line_index}-description" t-att-value="line.description"/>
                            </div>
                            <div class="col-md-1">
                                <label class="form-label">Qty</label>
                                <input type="number" min="1" class="form-control dental-quantity-input" readonly="readonly" t-attf-name="lines-#{line_index}-quantity" t-att-value="line.quantity"/>
                            </div>
                            <div class="col-md-2 form-check pt-4">
                                <input type="checkbox" class="form-check-input" t-attf-id="implant-#{line_index}"
                                    t-attf-name="lines-#{line_index}-is_implant" t-att-checked="'checked' if line.is_implant else None"/>
                                <label class="form-check-label" t-attf-for="implant-#{line_index}">Implant</label>
                            </div>
                            <div class="col-md-1">
                                <button type="button" class="btn btn-outline-danger btn-sm dental-remove-line"><i class="fa fa-trash"/></button>
                            </div>
                        </div>
                    </t>
                </t>
                <t t-else="">
                    <div class="row g-2 align-items-end dental-line-row border rounded p-2 mb-2">
                        <div class="col-md-2">
                            <label class="form-label">Teeth</label>
                            <input type="text" class="form-control dental-teeth-input" readonly="readonly"
                                required="required" placeholder="Select..." name="lines-0-teeth"/>
                            <button type="button" class="btn btn-outline-secondary btn-sm w-100 mt-1 dental-select-teeth">Select</button>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Work Type</label>
                            <select class="form-select" required="required" name="lines-0-work_type">
                                <option value="">-- Select --</option>
                                <option value="zircon">Zircon</option>
                                <option value="ccm">CCM</option>
                                <option value="ceramic_metal">Metal-Ceramic</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Description</label>
                            <input type="text" class="form-control" name="lines-0-description"/>
                        </div>
                        <div class="col-md-1">
                            <label class="form-label">Qty</label>
                            <input type="number" min="1" class="form-control dental-quantity-input" readonly="readonly" name="lines-0-quantity" value="1"/>
                        </div>
                        <div class="col-md-2 form-check pt-4">
                            <input type="checkbox" class="form-check-input" id="implant-0" name="lines-0-is_implant"/>
                            <label class="form-check-label" for="implant-0">Implant</label>
                        </div>
                        <div class="col-md-1">
                            <button type="button" class="btn btn-outline-danger btn-sm dental-remove-line"><i class="fa fa-trash"/></button>
                        </div>
                    </div>
                </t>
            </div>
            <button type="button" id="dental-add-line" class="btn btn-secondary btn-sm mt-1">
                <i class="fa fa-plus"/> Add Line
            </button>
        </div>

        <!-- Shared odontogram modal (built once per page, reused by every line's Select button) -->
        <div class="modal fade" id="dental-odontogram-modal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Select Teeth (FDI)</h5>
                        <button type="button" class="btn-close dental-odontogram-close" aria-label="Close"/>
                    </div>
                    <div class="modal-body">
                        <div id="dental-odontogram-chart"/>
                        <p class="text-muted small mt-2 mb-0">Selected: <span id="dental-odontogram-selected">None</span></p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary dental-odontogram-close">Cancel</button>
                        <button type="button" id="dental-odontogram-apply" class="btn btn-primary">Apply</button>
                    </div>
                </div>
            </div>
        </div>
    </template>
    

    <!-- Work orders List View -->
    <template id="portal_my_dental_orders" name="My Dental Work Orders">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Work Orders</t>
            </t>

            <div class="mb-3">
                <a href="/my/dental-orders/new" class="btn btn-primary">
                    <i class="fa fa-plus"/> Create
                </a>
            </div>

            <t t-if="not orders">
                <p>There are no dental work orders yet.</p>
            </t>
            <t t-if="orders" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Reference</th>
                        <th>Patient</th>
                        <th>Order Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="orders" t-as="order">
                        <td>
                            <a t-attf-href="/my/dental-orders/#{order.id}">
                                <span t-field="order.name"/>
                            </a>
                        </td>
                        <td><span t-field="order.patient_name"/></td>
                        <td><span t-field="order.date_order"/></td>
                        <td>
                            <span t-field="order.state" t-attf-class="badge #{'text-bg-success' if order.state == 'done' else ('text-bg-warning' if order.state == 'in_progress' else 'text-bg-secondary')}"/>
                            <a t-if="order.state == 'draft'" t-attf-href="/my/dental-orders/#{order.id}/edit" class="ms-2" title="Edit">
                                <i class="fa fa-pencil"/>
                            </a>
                        </td>
                    </tr>
                </tbody>
            </t>
            
        </t>
    </template>

    <!-- CREATE NEW RECORD VIEW -->
    <template id="portal_dental_order_form" name="New Dental Work Order">
        <t t-call="portal.portal_layout">
            <t t-set="page_name" t-value="'dental_order_new'"/>
            <t t-set="order" t-value="False"/>
            <div class="o_portal_my_doc_book_container">
                <h3>New Work Order</h3>
                <form action="/my/dental-orders/submit" method="post" class="row g-3">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <t t-call="dental_lab.portal_dental_order_form_fields"/>
                    <t t-call="dental_lab.portal_dental_order_lines"/>
                    <t t-call="dental_lab.portal_dental_order_attachments"/>
                    <div class="col-12">
                        <a href="/my/dental-orders" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">Submit Work Order</button>
                    </div>
                </form>
            </div>
        </t>
    </template>


    <!-- EDIT EXISTING RECORD VIEW (draft only) -->
    <template id="portal_dental_order_edit_form" name="Edit Dental Work Order">
        <t t-call="portal.portal_layout">
            <t t-set="additional_title" t-value="order.name"/>
            <div class="o_portal_my_doc_book_container">
                <h3>Edit Work Order <span t-field="order.name"/></h3>
                <form t-attf-action="/my/dental-orders/#{order.id}/update" method="post" enctype="multipart/form-data" class="row g-3">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <t t-call="dental_lab.portal_dental_order_form_fields"/>
                    <t t-call="dental_lab.portal_dental_order_lines"/>
                    <t t-call="dental_lab.portal_dental_order_attachments"/>
                    <div class="col-12">
                        <a t-attf-href="/my/dental-orders/#{order.id}" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>
                </form>
            </div>
        </t>
    </template>


    <!-- WORK ORDER FORM VIEW -->
    <template id="portal_dental_order_page" name="Dental Work Order">
        <t t-call="portal.portal_layout">
            <t t-set="additional_title" t-value="order.name"/>
            <div class="o_portal_my_doc_book_container">
                <h3>
                    Work Order <span t-field="order.name"/>
                    <span t-field="order.state" t-attf-class="badge float-end #{'text-bg-success' if order.state == 'done' else ('text-bg-warning' if order.state == 'in_progress' else 'text-bg-secondary')}"/>
                </h3>
                <table class="table table-borderless">
                    <tr><td class="fw-bold">Patient</td><td><span t-field="order.patient_name"/></td></tr>
                    <tr><td class="fw-bold">Shade</td><td><span t-field="order.shade"/></td></tr>
                    <tr><td class="fw-bold">Order Date</td><td><span t-field="order.date_order"/></td></tr>
                    <tr><td class="fw-bold">Due Date</td><td><span t-field="order.date_due"/></td></tr>
                    <tr><td class="fw-bold">Technician</td><td><span t-field="order.technician_id.name"/></td></tr>
                    <tr><td class="fw-bold">Notes</td><td><span t-field="order.notes"/></td></tr>
                </table>
                <h5 class="mt-4">Work Details</h5>
                <table class="table table-sm table-bordered" t-if="order.work_order_line_ids">
                    <thead>
                        <tr><th>Teeth</th><th>Work Type</th><th>Description</th><th>Qty</th><th>Implant</th></tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="order.work_order_line_ids" t-as="line">
                            <td><span t-field="line.teeth"/></td>
                            <td><span t-field="line.work_type"/></td>
                            <td><span t-field="line.description"/></td>
                            <td><span t-field="line.quantity"/></td>
                            <td><t t-if="line.is_implant">Yes</t><t t-else="">No</t></td>
                        </tr>
                    </tbody>
                </table>
                <a t-if="order.state == 'draft'" t-attf-href="/my/dental-orders/#{order.id}/edit" class="btn btn-primary mt-2">
                    <i class="fa fa-pencil"/> Edit Work Order
                </a>
                <h5 class="mt-4">X-Rays / Scans</h5>
                <ul class="list-group" t-if="order.attachment_ids">
                    <li t-foreach="order.attachment_ids" t-as="attachment" class="list-group-item">
                        <a t-attf-href="/web/content/#{attachment.id}?download=true" target="_blank">
                            <i class="fa fa-paperclip me-1"/><t t-esc="attachment.name"/>
                        </a>
                    </li>
                </ul>
            </div>
        </t>
    </template>

    <template id="portal_dental_order_form_fields" name="Dental Work Order Form Fields">
        <div class="col-md-6">
            <label class="form-label" for="patient_name">Patient Name</label>
            <input type="text" class="form-control" id="patient_name" name="patient_name"
                t-att-value="order.patient_name if order else ''" required="required"/>
        </div>
        <div class="col-md-6">
            <label class="form-label" for="shade">Shade / Color</label>
            <input type="text" class="form-control" id="shade" name="shade"
                t-att-value="order.shade if order else ''"/>
        </div>
        <div class="col-md-6">
            <label class="form-label" for="date_due">Due Date</label>
            <input type="date" class="form-control" id="date_due" name="date_due"
                t-att-value="order.date_due if order else ''"/>
        </div>
        <div class="col-md-6">
            <label class="form-label" for="priority">Priority</label>
            <select class="form-select" id="priority" name="priority">
                <option value="0" t-att-selected="'selected' if not order or order.priority == '0' else None">Normal</option>
                <option value="1" t-att-selected="'selected' if order and order.priority == '1' else None">Urgent</option>
            </select>
        </div>
        <div class="col-12">
            <label class="form-label" for="notes">Instructions / Notes</label>
            <textarea class="form-control" id="notes" name="notes" rows="4"><t t-esc="order.notes if order else ''"/></textarea>
        </div>
    </template>

    <!-- Attachement template -->
    <template id="portal_dental_order_attachments" name="Dental Work Order Attachments">
        <div class="col-12 dental-attachments" t-att-data-order-id="order.id if order else 0">
            <label class="form-label fw-bold">X-Rays / Scans</label>
            <t t-if="order and order.attachment_ids">
                <ul class="list-group mb-2">
                    <li t-foreach="order.attachment_ids" t-as="attachment"
                        class="list-group-item d-flex justify-content-between align-items-center">
                        <a t-attf-href="/web/content/#{attachment.id}?download=true" target="_blank">
                            <i class="fa fa-paperclip me-1"/><t t-esc="attachment.name"/>
                        </a>
                        <button type="button" class="btn btn-outline-danger btn-sm dental-remove-attachment"
                                t-att-data-attachment-id="attachment.id">
                            <i class="fa fa-trash"/>
                        </button>
                    </li>
                </ul>
            </t>
            <input type="file" class="form-control" name="attachments" multiple="multiple" accept=".stl,.obj,.rar,.zip"/>
            <div class="form-text">JPEG, PNG, WEBP or PDF, up to 50 MB each.</div>
        </div>
    </template>
</odoo>